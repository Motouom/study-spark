VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ADMIN_AUTH_ENDPOINT=
# Server-only. Used for admin/database RPCs and persistent AI quota tracking.
# AI provider calls still work without this key, but usage caps are not persisted.
SUPABASE_SERVICE_ROLE_KEY=
FAPSHI_ENVIRONMENT=sandbox
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_WEBHOOK_SECRET=

# ── AI Providers (new multi-provider fallback) ──────────────────────────────
# Priority order: Gemini → Groq → Cerebras
# Get free API keys from:
#   Gemini:    https://aistudio.google.com/app/apikey
#   Groq:      https://console.groq.com/keys
#   Cerebras:  https://cloud.cerebras.ai/
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Optional: override daily caps (defaults shown below)
# GEMINI_DAILY_CAP=1500
# GROQ_DAILY_CAP=1000
# CEREBRAS_DAILY_CAP=5000

# Legacy single-provider config (kept for backwards compatibility)
OPENROUTER_API_KEY=
AI_MODEL=openrouter/free
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_MS=25000

APP_PUBLIC_URL=http://127.0.0.1:8082
